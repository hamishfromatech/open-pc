            "type": "integer"
          },
          "start_x": {
            "description": "Start X coordinate (>= 0)",
            "minimum": 0.0,
            "title": "Start X",
            "type": "integer"
          },
          "start_y": {
            "description": "Start Y coordinate (>= 0)",
            "minimum": 0.0,
            "title": "Start Y",
            "type": "integer"
          }
