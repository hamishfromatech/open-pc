        "type": "object"
      },
      "MouseDragRequest": {
        "properties": {
          "duration": {
            "default": 0.5,
            "description": "Drag duration in seconds",
            "minimum": 0.0,
            "title": "Duration",
            "type": "number"
          },
          "end_x": {
            "description": "End X coordinate (>= 0)",
            "minimum": 0.0,
            "title": "End X",
            "type": "integer"
          },
          "end_y": {
            "description": "End Y coordinate (>= 0)",
            "minimum": 0.0,
