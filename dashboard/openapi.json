      "MouseClickRequest": {
        "properties": {
          "button": {
            "default": "left",
            "pattern": "^(left|right|middle)$",
            "title": "Button",
            "type": "string"
          },
          "clicks": {
            "default": 1,
            "description": "Number of clicks (1-3)",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Clicks",
            "type": "integer"
          },
          "duration": {
            "default": 0.0,
            "description": "Animation duration in seconds",
            "minimum": 0.0,
            "title": "Duration",
            "type": "number"
          },
          "x": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "X coordinate (>= 0)",
            "title": "X"
          },
          "y": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
