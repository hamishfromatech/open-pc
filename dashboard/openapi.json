            "type": "string"
          }
        },
        "required": [
          "application"
        ],
        "title": "LaunchRequest",
        "type": "object"
      },
      "LocateOnScreenBase64Request": {
        "properties": {
          "confidence": {
            "default": 0.9,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
