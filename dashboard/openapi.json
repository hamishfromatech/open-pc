{
  "components": {
    "schemas": {
      "BatchRequest": {
        "properties": {
          "steps": {
            "items": {
              "$ref": "#/components/schemas/BatchStep"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "steps"
        ],
        "title": "BatchRequest",
        "type": "object"
      },
      "BatchStep": {
        "properties": {
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "BatchStep",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "KeyboardHotkeyRequest": {
        "properties": {
          "keys": {
            "description": "Keys for hotkey combination (max 10)",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Keys",
            "type": "array"
          }
        },
        "required": [
          "keys"
        ],
        "title": "KeyboardHotkeyRequest",
        "type": "object"
      },
      "KeyboardKeyRequest": {
        "properties": {
          "key": {
            "description": "Key to press",
            "maxLength": 50,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "title": "KeyboardKeyRequest",
        "type": "object"
      },
      "KeyboardTypeRequest": {
        "properties": {
          "interval": {
            "default": 0.05,
            "description": "Keystroke delay in seconds",
            "minimum": 0.0,
            "title": "Interval",
            "type": "number"
          },
          "text": {
            "description": "Text to type (max 10KB)",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "KeyboardTypeRequest",
        "type": "object"
      },
      "LaunchRequest": {
        "properties": {
          "application": {
