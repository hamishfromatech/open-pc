# Open-PC Configuration

# VNC Password (change this for security!)
VNC_PASSWORD=openpc

# Screen Resolution
VNC_RESOLUTION=1920x1080

# Require authentication for WebSocket connections
AUTH_REQUIRED=true

# REST API Token (optional, set to protect REST endpoints)
# Leave empty to allow unauthenticated REST access, or set a secret token.
# When set, the dashboard and MCP server automatically use this token too
# (dashboard via build arg, MCP server as its auth credential).
REST_AUTH_TOKEN=

# Open-PC Host (for MCP server connection)
OPENPC_HOST=open-pc-desktop
OPENPC_PORT=8080

# MCP Server Port (external: 8091)
MCP_PORT=8000

# Ports (host machine):
# 5901 - VNC Server
# 6080 - noVNC Web Interface
# 8090 - Agent REST API
# 8091 - MCP Server
# 8092 - Web Dashboard